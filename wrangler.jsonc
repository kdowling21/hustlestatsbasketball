{
  // Cloudflare Workers config for hustlestatsbasketball.com
  "name": "hustlestatsbasketball",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "hustlestatsbasketball.com", "custom_domain": true },
    { "pattern": "www.hustlestatsbasketball.com", "custom_domain": true }
  ],
  "observability": { "enabled": true }
}
